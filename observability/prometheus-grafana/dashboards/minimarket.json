{
  "title": "MiniMarket - Observabilidad",
  "uid": "minimarket-obs",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU por namespace (nucleos)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{namespace}}",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~'minimarket-.*',container!=''}[2m])) by (namespace)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RAM por namespace",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{namespace}}",
          "expr": "sum(container_memory_working_set_bytes{namespace=~'minimarket-.*',container!=''}) by (namespace)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Trafico por endpoint (req/s)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{exported_endpoint}}",
          "expr": "sum(rate(minimarket_requests_total[1m])) by (exported_endpoint)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Errores 5xx en el gateway (req/s)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{response_code}}",
          "expr": "sum(rate(istio_requests_total{source_workload=\"istio-ingressgateway\",response_code=~\"5..\"}[1m])) by (response_code)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia p95 por servicio",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{service}}",
          "expr": "histogram_quantile(0.95, sum(rate(minimarket_request_duration_seconds_bucket[1m])) by (le, service))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Ventas completadas",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(istio_requests_total{source_workload=\"istio-ingressgateway\",response_code=\"201\"}[$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Ingresos acumulados (S/)",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(minimarket_sales_revenue_soles_total[$__range]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Peticiones fallidas 5xx",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(istio_requests_total{source_workload=\"istio-ingressgateway\",response_code=~\"5..\"}[$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Replicas de ventas-api (HPA)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "replicas",
          "expr": "kube_deployment_status_replicas{namespace=\"minimarket-backend\",deployment=\"ventas-api\"}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Respuestas del gateway por codigo (req/s)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{response_code}}",
          "expr": "sum(rate(istio_requests_total{source_workload=\"istio-ingressgateway\"}[1m])) by (response_code)"
        }
      ]
    }
  ]
}