# Entorno de desarrollo local MiniMarket Cloud
# Copiar a .env para personalizar

# Base de datos PostgreSQL
POSTGRES_USER=minimarket_user
POSTGRES_PASSWORD=minimarket_password
POSTGRES_DB=minimarket_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# URL de conexión SQLAlchemy
# Para Docker Compose interno usar: postgresql://minimarket_user:minimarket_password@postgres:5432/minimarket_db
# Para ejecución local desde host usar: postgresql://minimarket_user:minimarket_password@localhost:5433/minimarket_db
DATABASE_URL=postgresql://minimarket_user:minimarket_password@localhost:5433/minimarket_db

# Microservicio ventas-api
VENTAS_API_PORT=8000
LOW_STOCK_THRESHOLD=5

# Microservicio reportes-api
REPORTES_API_PORT=8001

# Frontend
FRONTEND_PORT=8080
VENTAS_API_URL=http://localhost:8000
REPORTES_API_URL=http://localhost:8001
